}
Usuario "1" o-- "1" PerfilUsuario : posee >
Usuario "1" o-- "1" ProgresoAcademico : genera >
Usuario "1" --> "0..*" CursoLeccion : cursa >
Usuario "1" --> "0..*" Normativa : consulta (en <= 2 clics) >


@enduml
